# The desktop app's release, for PortableKit's release scripts:
#   scripts/release_macos.sh --game . --packaging apps/portablekit/packaging <build>
#   scripts/package_desktop_windows.ps1 -BuildDir <build> -Toolchain <llvm-mingw>
# (see docs/RELEASING.md, "The desktop app").
RELEASE_NAME=PortableKit
RELEASE_SLUG=portablekit
RELEASE_TARGET=portablekit
RELEASE_APP_ID=io.github.teamgdb.PortableKit
RELEASE_SUMMARY="Play the PSP games you own by recompiling them on your computer"
RELEASE_URL=https://github.com/TeamGDB/PortableKit
RELEASE_OVERLAYS=0
# The profile directory, whose game/ a developer build falls back to.
RELEASE_PROFILE_DIR=apps/portablekit
# The recompiler runs beside the program, and the headers the code it makes
# includes go in Contents/Resources/include, where the program looks for them.
RELEASE_EXTRA_EXECUTABLES=psp_recomp
RELEASE_RESOURCES="share/portablekit/include=include"
# The app knows no game, so no name of one is listed; the scripts' own checks
# for disc images, executables and saves still apply.
RELEASE_GAME_NAMES=""
