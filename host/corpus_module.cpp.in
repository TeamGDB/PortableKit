// Entry points of one corpus library (host/corpus_library.hpp), configured by
// portablekit_add_game() for an edition's corpus. Everything else in the
// library is psp_recomp output.
#include "psprecomp/corpus_abi.hpp"

namespace psprecomp {
const char *generated_corpus_source_sha256();
}

#if defined(_WIN32)
#define PORTABLEKIT_CORPUS_EXPORT __declspec(dllexport)
#else
#define PORTABLEKIT_CORPUS_EXPORT __attribute__((visibility("default")))
#endif

extern "C" PORTABLEKIT_CORPUS_EXPORT std::uint32_t portablekit_corpus_abi_version() {
    return psprecomp::kCorpusAbiVersion;
}
extern "C" PORTABLEKIT_CORPUS_EXPORT const char *portablekit_corpus_executable() {
    return psprecomp::generated_corpus_source_sha256();
}
extern "C" PORTABLEKIT_CORPUS_EXPORT void portablekit_corpus_register(psprecomp::CorpusRuntime &runtime) {
    psprecomp::register_generated_functions(runtime);
}
